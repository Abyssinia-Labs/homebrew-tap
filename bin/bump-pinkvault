#!/usr/bin/env bash
# bin/bump-pinkvault [--check] [VERSION]
# bin/bump-pinkvault --revise
#
# Writes Formula/pinkvault.rb for a PinkVault release, from that release's
# checksums manifest, and only once the manifest's minisign signature verifies
# against pinkvault.pub: PinkVault's release key (pinkvault.pub in
# Abyssinia-Labs/latem-vault), not latem's. So no sha256 in the formula is one
# that key did not sign, and Homebrew's own check of each download against it
# finishes the chain.
#
# PinkVault was latem vault until 0.7.0. The first time this writes the
# formula, it also takes out Formula/latem-vault.rb and names pinkvault as its
# new name in formula_renames.json, in the same change: brew update then moves
# an installed latem-vault to pinkvault, and brew upgrade takes it to this
# release. Until then the tap keeps latem-vault 0.6.0, so it never names a
# formula that isn't there.
#
# With no VERSION, the latest release. --check writes nothing, and prints the
# version a bump would write, or nothing when the formula is already at it.
#
# --revise writes the formula again at the version it already has, verified
# the same way, with its revision one higher, so `brew upgrade` reinstalls the
# same release. Use it after changing what the formula installs. A new version
# starts again with no revision.
set -euo pipefail

repo=Abyssinia-Labs/latem-vault
# The first release published as pinkvault.
floor=${BUMP_FLOOR:-0.7.0}

here=$(cd "$(dirname "$0")/.." && pwd)
formula=$here/Formula/pinkvault.rb
pubkey=$here/pinkvault.pub
# The formula's name before 0.7.0, and the file that renames it.
old_formula=$here/Formula/latem-vault.rb
renames=$here/formula_renames.json

check=false
revise=false
case "${1:-}" in
  --check)
    check=true
    shift
    ;;
  --revise)
    revise=true
    shift
    ;;
esac

current=""
revision=0
if [ -f "$formula" ]; then
  # Homebrew reads the version from the URL, and its audit refuses a
  # version line that repeats it, so this does too.
  current=$(sed -n 's|.*/releases/download/v\([0-9.]*\)/.*|\1|p' "$formula" | head -n 1)
fi

tag=${1:-}
if $revise; then
  if [ -z "$current" ] || [ -n "$tag" ]; then
    echo "bump-pinkvault: --revise takes no version, and needs a formula to revise" >&2
    exit 1
  fi
  tag=$current
  revision=$(sed -n 's/^  revision \([0-9][0-9]*\)$/\1/p' "$formula")
  revision=$((${revision:-0} + 1))
fi
if [ -z "$tag" ]; then
  tag=$(gh release view --repo "$repo" --json tagName --jq .tagName)
fi
tag=v${tag#v}
bare=${tag#v}
if ! printf '%s' "$bare" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "bump-pinkvault: $tag is not a vMAJOR.MINOR.PATCH release" >&2
  exit 1
fi

# newer A B: A is a later version than B.
newer() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

if [ "$bare" = "$current" ] && ! $revise; then
  $check || echo "bump-pinkvault: the formula is already pinkvault $bare"
  exit 0
fi
if [ -n "$current" ] && ! $revise && ! newer "$bare" "$current"; then
  echo "bump-pinkvault: $bare is older than the formula's $current; a tap does not go back" >&2
  exit 1
fi
if [ "$bare" != "$floor" ] && ! newer "$bare" "$floor"; then
  # Until 0.7.0 is out, the latest release is latem vault's, which
  # Formula/latem-vault.rb already has: nothing to do, and no error.
  $check && exit 0
  echo "bump-pinkvault: $bare predates $floor, the first release as pinkvault" >&2
  exit 1
fi
if $check; then
  echo "$bare"
  exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
sums=pinkvault_${bare}_checksums.txt
base=https://github.com/$repo/releases/download/$tag
curl -fsSL --retry 3 -o "$work/$sums" "$base/$sums"
curl -fsSL --retry 3 -o "$work/$sums.minisig" "$base/$sums.minisig"

# -Q prints the trusted comment, and only once both signatures verify. The
# comment is signed too, and the release workflow writes the tag into it.
if ! comment=$(minisign -V -Q -p "$pubkey" -m "$work/$sums" -x "$work/$sums.minisig"); then
  echo "bump-pinkvault: $sums does not verify against pinkvault.pub; nothing written" >&2
  exit 1
fi
if [ "$comment" != "pinkvault $tag" ]; then
  echo "bump-pinkvault: $sums is signed with the comment \"$comment\", not \"pinkvault $tag\"" >&2
  exit 1
fi

# sha OS_ARCH: the signed sha256 of that platform's archive. The asset name
# carries the version, so a manifest signed for another release has no line
# for it.
sha() {
  local name=pinkvault_${bare}_$1.tar.gz sum
  sum=$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' "$work/$sums")
  if ! printf '%s' "$sum" | grep -Eq '^[0-9a-f]{64}$'; then
    echo "bump-pinkvault: $sums signs no single sha256 for $name" >&2
    return 1
  fi
  printf '%s' "$sum"
}
darwin_arm64=$(sha darwin_arm64)
darwin_amd64=$(sha darwin_amd64)
linux_arm64=$(sha linux_arm64)
linux_amd64=$(sha linux_amd64)
keyid=$(sed -n 's/^untrusted comment: minisign public key //p' "$pubkey")

mkdir -p "$(dirname "$formula")"
# Quoted, with placeholders filled in after: the formula is Ruby, whose
# #{...} and backticks a shell heredoc would otherwise rewrite.
cat > "$formula.tmp" <<'EOF'
# Written by bin/bump-pinkvault from PinkVault __TAG__'s checksums, signed
# by PinkVault's release key __KEYID__. Change bin/bump-pinkvault, not this file.
class Pinkvault < Formula
  # pinkvault's short name, linked to it.
  SHORT_NAMES = %w[pink].freeze
  # Its names before 0.7.0, latem vault's and OpenVault's, linked to it for
  # one release. Run by one, it says first, on stderr, that it is pinkvault
  # now. OV-15 takes them out.
  OLD_NAMES = %w[latem-vault openvault].freeze

  desc "Encrypted secrets, variables and files synced across your own devices"
  homepage "https://github.com/Abyssinia-Labs/latem-vault"
  license any_of: ["Apache-2.0", "MIT"]
__REVISION__

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "__BASE__/pinkvault___BARE___darwin_arm64.tar.gz"
      sha256 "__DARWIN_ARM64__"
    end
    on_intel do
      url "__BASE__/pinkvault___BARE___darwin_amd64.tar.gz"
      sha256 "__DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "__BASE__/pinkvault___BARE___linux_arm64.tar.gz"
      sha256 "__LINUX_ARM64__"
    end
    on_intel do
      url "__BASE__/pinkvault___BARE___linux_amd64.tar.gz"
      sha256 "__LINUX_AMD64__"
    end
  end

  def install
    bin.install "pinkvault"
    # Linked here rather than taken from the archive's own links, so the
    # names are this formula's to change. The caveats name them too.
    (SHORT_NAMES + OLD_NAMES).each { |name| bin.install_symlink "pinkvault" => name }
  end

  def caveats
    <<~EOS
      pink is a short name for pinkvault: `pink devices` runs
      `pinkvault devices`. For this release only, latem-vault and openvault
      run it too, after a line on stderr naming pinkvault.

      latem vault is now PinkVault. Update latem to 0.14.0 or later, then run:
        pinkvault service install
      It stops the old service, moves ~/.latem-vault (or ~/.openvault) to
      ~/.pinkvault and starts PinkVault's. A service installed by 0.6.0
      started that version's keg, which this upgrade removed, so it is not
      running until you do. On a Mac, allow pinkvault on the local network
      when macOS asks, or it can't sync.
    EOS
  end

  test do
    assert_match "pinkvault #{version} (", shell_output("#{bin}/pinkvault --version")
    SHORT_NAMES.each do |name|
      assert_match "pinkvault #{version} (", shell_output("#{bin}/#{name} --version")
    end
    OLD_NAMES.each do |name|
      old = shell_output("#{bin}/#{name} --version 2>&1")
      assert_match "`#{name}` is now `pinkvault`", old
      assert_match "pinkvault #{version} (", old
    end
  end
end
EOF
sed -e "s|__TAG__|$tag|g" -e "s|__KEYID__|$keyid|g" -e "s|__BARE__|$bare|g" -e "s|__BASE__|$base|g" \
  -e "s|__DARWIN_ARM64__|$darwin_arm64|g" -e "s|__DARWIN_AMD64__|$darwin_amd64|g" \
  -e "s|__LINUX_ARM64__|$linux_arm64|g" -e "s|__LINUX_AMD64__|$linux_amd64|g" \
  "$formula.tmp" > "$formula.new"
if [ "$revision" -gt 0 ]; then
  sed "s|^__REVISION__$|  revision $revision|" "$formula.new" > "$formula"
else
  sed '/^__REVISION__$/d' "$formula.new" > "$formula"
fi
rm "$formula.tmp" "$formula.new"

# The rename, with the formula it names: latem-vault's formula goes, and
# formula_renames.json says where. Homebrew reads the old name from here, not
# from an alias: an alias resolves `brew install latem-vault`, but only a
# rename moves a latem-vault already installed. OV-15 can drop this block;
# the file stays as long as anyone may upgrade from 0.6.0.
rm -f "$old_formula"
printf '{\n  "latem-vault": "pinkvault"\n}\n' > "$renames"

if [ "$revision" -gt 0 ]; then
  echo "bump-pinkvault: wrote pinkvault $bare, revision $revision, to Formula/pinkvault.rb"
else
  echo "bump-pinkvault: wrote pinkvault $bare to Formula/pinkvault.rb"
fi
