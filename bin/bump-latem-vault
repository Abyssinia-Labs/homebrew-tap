#!/usr/bin/env bash
# bin/bump-latem-vault [--check] [VERSION]
# bin/bump-latem-vault --revise
#
# Writes Formula/latem-vault.rb for a latem vault release, from that release's
# checksums manifest, and only once the manifest's minisign signature verifies
# against latem-vault.pub: latem vault's release key (latem-vault.pub in
# Abyssinia-Labs/latem-vault), not latem's. So no sha256 in the formula is one
# that key did not sign, and Homebrew's own check of each download against it
# finishes the chain.
#
# With no VERSION, the latest release. --check writes nothing, and prints the
# version a bump would write, or nothing when the formula is already at it.
#
# --revise writes the formula again at the version it already has, verified
# the same way, with its revision one higher, so `brew upgrade` reinstalls the
# same release. Use it after changing what the formula installs. A new version
# starts again with no revision.
set -euo pipefail

repo=Abyssinia-Labs/latem-vault
# The first release published as latem-vault.
floor=${BUMP_FLOOR:-0.6.0}

here=$(cd "$(dirname "$0")/.." && pwd)
formula=$here/Formula/latem-vault.rb
pubkey=$here/latem-vault.pub

check=false
revise=false
case "${1:-}" in
  --check)
    check=true
    shift
    ;;
  --revise)
    revise=true
    shift
    ;;
esac

current=""
revision=0
if [ -f "$formula" ]; then
  # Homebrew reads the version from the URL, and its audit refuses a
  # version line that repeats it, so this does too.
  current=$(sed -n 's|.*/releases/download/v\([0-9.]*\)/.*|\1|p' "$formula" | head -n 1)
fi

tag=${1:-}
if $revise; then
  if [ -z "$current" ] || [ -n "$tag" ]; then
    echo "bump-latem-vault: --revise takes no version, and needs a formula to revise" >&2
    exit 1
  fi
  tag=$current
  revision=$(sed -n 's/^  revision \([0-9][0-9]*\)$/\1/p' "$formula")
  revision=$((${revision:-0} + 1))
fi
if [ -z "$tag" ]; then
  tag=$(gh release view --repo "$repo" --json tagName --jq .tagName)
fi
tag=v${tag#v}
bare=${tag#v}
if ! printf '%s' "$bare" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "bump-latem-vault: $tag is not a vMAJOR.MINOR.PATCH release" >&2
  exit 1
fi

# newer A B: A is a later version than B.
newer() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

if [ "$bare" = "$current" ] && ! $revise; then
  $check || echo "bump-latem-vault: the formula is already latem-vault $bare"
  exit 0
fi
if [ -n "$current" ] && ! $revise && ! newer "$bare" "$current"; then
  echo "bump-latem-vault: $bare is older than the formula's $current; a tap does not go back" >&2
  exit 1
fi
if [ "$bare" != "$floor" ] && ! newer "$bare" "$floor"; then
  echo "bump-latem-vault: $bare predates $floor, the first release as latem-vault" >&2
  $check && exit 0
  exit 1
fi
if $check; then
  echo "$bare"
  exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
sums=latem-vault_${bare}_checksums.txt
base=https://github.com/$repo/releases/download/$tag
curl -fsSL --retry 3 -o "$work/$sums" "$base/$sums"
curl -fsSL --retry 3 -o "$work/$sums.minisig" "$base/$sums.minisig"

# -Q prints the trusted comment, and only once both signatures verify. The
# comment is signed too, and the release workflow writes the tag into it.
comment=$(minisign -V -Q -p "$pubkey" -m "$work/$sums" -x "$work/$sums.minisig")
if [ "$comment" != "latem-vault $tag" ]; then
  echo "bump-latem-vault: $sums is signed with the comment \"$comment\", not \"latem-vault $tag\"" >&2
  exit 1
fi

# sha OS_ARCH: the signed sha256 of that platform's archive. The asset name
# carries the version, so a manifest signed for another release has no line
# for it.
sha() {
  local name=latem-vault_${bare}_$1.tar.gz sum
  sum=$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' "$work/$sums")
  if ! printf '%s' "$sum" | grep -Eq '^[0-9a-f]{64}$'; then
    echo "bump-latem-vault: $sums signs no single sha256 for $name" >&2
    return 1
  fi
  printf '%s' "$sum"
}
darwin_arm64=$(sha darwin_arm64)
darwin_amd64=$(sha darwin_amd64)
linux_arm64=$(sha linux_arm64)
linux_amd64=$(sha linux_amd64)
keyid=$(sed -n 's/^untrusted comment: minisign public key //p' "$pubkey")

mkdir -p "$(dirname "$formula")"
# Quoted, with placeholders filled in after: the formula is Ruby, whose
# #{...} and backticks a shell heredoc would otherwise rewrite.
cat > "$formula.tmp" <<'EOF'
# Written by bin/bump-latem-vault from latem vault __TAG__'s checksums, signed
# by latem vault's release key __KEYID__. Change bin/bump-latem-vault, not this file.
class LatemVault < Formula
  desc "Encrypted secrets, variables and files synced across your own devices"
  homepage "https://github.com/Abyssinia-Labs/latem-vault"
  license any_of: ["Apache-2.0", "MIT"]
__REVISION__

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "__BASE__/latem-vault___BARE___darwin_arm64.tar.gz"
      sha256 "__DARWIN_ARM64__"
    end
    on_intel do
      url "__BASE__/latem-vault___BARE___darwin_amd64.tar.gz"
      sha256 "__DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "__BASE__/latem-vault___BARE___linux_arm64.tar.gz"
      sha256 "__LINUX_ARM64__"
    end
    on_intel do
      url "__BASE__/latem-vault___BARE___linux_amd64.tar.gz"
      sha256 "__LINUX_AMD64__"
    end
  end

  def install
    bin.install "latem-vault"
    # Short names, as latem has ltm. The binary keeps its name: latem looks
    # it up as latem-vault.
    bin.install_symlink "latem-vault" => "vault"
    bin.install_symlink "latem-vault" => "lv"
    # OpenVault's old command, for scripts that still call it: it says the
    # new name, then runs it. For the release that renamed it only; OV-15
    # takes it out.
    (bin/"openvault").write <<~SH
      #!/bin/sh
      echo "openvault is now latem-vault: run latem-vault instead." >&2
      exec "#{opt_bin}/latem-vault" "$@"
    SH
    chmod 0755, bin/"openvault"
  end

  def caveats
    <<~EOS
      vault and lv are short names for latem-vault: `lv devices` runs
      `latem-vault devices`.
      HashiCorp Vault has a vault command too. Where both are on PATH, lv is
      always latem vault; Homebrew won't link both formulae.

      OpenVault is now latem vault. To move a vault from ~/.openvault to
      ~/.latem-vault, update latem to 0.12.0 or later, then run:
        latem-vault service install
    EOS
  end

  test do
    assert_match "latem-vault #{version} (", shell_output("#{bin}/latem-vault --version")
    assert_match "latem-vault #{version} (", shell_output("#{bin}/vault --version")
    assert_match "latem-vault #{version} (", shell_output("#{bin}/lv --version")
    old = shell_output("#{bin}/openvault --version 2>&1")
    assert_match "openvault is now latem-vault", old
    assert_match "latem-vault #{version} (", old
  end
end
EOF
sed -e "s|__TAG__|$tag|g" -e "s|__KEYID__|$keyid|g" -e "s|__BARE__|$bare|g" -e "s|__BASE__|$base|g" \
  -e "s|__DARWIN_ARM64__|$darwin_arm64|g" -e "s|__DARWIN_AMD64__|$darwin_amd64|g" \
  -e "s|__LINUX_ARM64__|$linux_arm64|g" -e "s|__LINUX_AMD64__|$linux_amd64|g" \
  "$formula.tmp" > "$formula.new"
if [ "$revision" -gt 0 ]; then
  sed "s|^__REVISION__$|  revision $revision|" "$formula.new" > "$formula"
else
  sed '/^__REVISION__$/d' "$formula.new" > "$formula"
fi
rm "$formula.tmp" "$formula.new"
if [ "$revision" -gt 0 ]; then
  echo "bump-latem-vault: wrote latem-vault $bare, revision $revision, to Formula/latem-vault.rb"
else
  echo "bump-latem-vault: wrote latem-vault $bare to Formula/latem-vault.rb"
fi
